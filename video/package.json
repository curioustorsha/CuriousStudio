{
  "name": "curiously-video",
  "private": true,
  "scripts": {
    "audio": "node --env-file=../.env.local scripts/generate-audio.mjs",
    "studio": "remotion studio",
    "render": "remotion render AmazonChaos out/raw.mp4 --codec=h264 --crf=16 --audio-bitrate=320k && node scripts/master.mjs out/raw.mp4 out/amazon-chaos.mp4 && remotion still Cover out/cover.png",
    "ep:new": "node scripts/new-episode.mjs",
    "ep:audio": "node --env-file=../.env.local scripts/generate-audio.mjs",
    "ep:preview": "node scripts/vo-preview.mjs",
    "ep:stt": "node --env-file=../.env.local scripts/stt-check.mjs",
    "ep:still": "node scripts/still.mjs",
    "ep:render": "node scripts/render.mjs",
    "ep:carousel": "node scripts/carousel.mjs",
    "ep:frames": "node scripts/frames.mjs",
    "ep:measure": "node scripts/measure.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/cli": "^4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^7.0.2"
  }
}
